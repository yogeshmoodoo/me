---
import Base from '../layouts/Base.astro';
import { SITE } from '../consts';
---
<Base title="Contact" description="Contact Yogesh Moodoo, Senior Technical Architect in Mauritius, by email, LinkedIn or GitHub.">
  <h1 class="label">contact yogesh moodoo</h1>
  <div class="grid">
    <article class="card"><a class="tile" href={`mailto:${SITE.email}`}><span class="k">email</span><span class="v">{SITE.email}</span></a></article>
    <article class="card"><a class="tile" href={SITE.linkedin} rel="me noopener"><span class="k">linkedin</span><span class="v">yogesh-moodoo</span></a></article>
    <article class="card"><a class="tile" href={SITE.github} rel="me noopener"><span class="k">github</span><span class="v">yogeshmoodoo</span></a></article>
  </div>
</Base>
