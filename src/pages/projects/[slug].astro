---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, summary, stack, role, links } = entry.data;
---
<Base title={title} description={summary}>
  <h1>{title}</h1>
  <p class="tags">{role} · {stack.join(' · ')}</p>
  <ul>{links.map((l) => <li><a href={l.url} rel="noopener">{l.label}</a></li>)}</ul>
  <Content />
</Base>
