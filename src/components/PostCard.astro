---
import { withBase } from '../consts';
const { slug, title, description, date, heading: Heading = 'h3' } = Astro.props;
---
<article class="post">
  <time datetime={date.toISOString()}>{date.toISOString().slice(0, 10)}</time>
  <div>
    <Heading><a href={withBase(`/blog/${slug}`)}>{title}</a></Heading>
    <p>{description}</p>
  </div>
</article>
